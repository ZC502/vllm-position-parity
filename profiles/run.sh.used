#!/usr/bin/env bash
# VPP (ZC502/vllm-position-parity) kv-cache-quant profile for vLLM PR #49764 on Pro6K (sm_120).
# Arms: ref_tp1 / ref_tp2 (BF16 weights) and fp8_tp1 / fp8_tp2 (online fp8_per_tensor weights).
# 16 default prompts x --repeats 2 per arm, sequential mode, prefix caching off, otherwise collector defaults.
set -uo pipefail
ROOT=/zhaojinbin/vllm-lab/pro6k; K=$ROOT/kvq; VPP=$K/vpp; V=$ROOT/venv-nightly-e9f169d16; PY=$V/bin/python
MODEL=Qwen/Qwen3-1.7B  # resolved offline from HF_HOME cache snapshot 70d244cc86ccca08cf5af4e1e306ecf908b1ad5e
OUT=$K/out/$(date -u +%Y%m%d-%H%M%S); mkdir -p "$OUT"; exec > >(tee "$OUT/run.log") 2>&1
echo "host=$(hostname) date=$(date -u)"; nvidia-smi -L | head -8; nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -1
export HF_HOME=/zhaojinbin/hf-cache HF_HUB_OFFLINE=1 TORCH_CUDA_ARCH_LIST=12.0 VLLM_USE_FLASHINFER_SAMPLER=0 VLLM_LOGGING_LEVEL=INFO VLLM_CACHE_ROOT=$K/vllm-cache
cp $K/provenance.json $OUT/; echo "vpp=$(git -C $VPP rev-parse --short HEAD) model=$MODEL"
$PY -c "import vllm,torch; print('env:', vllm.__version__, torch.__version__, 'cuda', torch.version.cuda)" || { echo ENV_IMPORT_FAILED; exit 2; }
COMMON="--execution-mode sequential --repeats 2 --prompt-logprobs 5 --max-tokens 64 --temperature 0 --disable-prefix-caching --metadata pr=#49764 --metadata cohort=short_default --metadata gpu=RTX_PRO_6000_sm120 --metadata vllm_commit=e9f169d16b9408bb9ae44f75072b91a5521d733c --metadata pr_merge_commit=8170c23c4fa36ffdc5890e5df46b4825fd9d0745 --metadata quant_scheme_candidate=fp8_per_tensor_online --metadata model_snapshot=70d244cc86ccca08cf5af4e1e306ecf908b1ad5e"
run_arm() { # arm gpus llm_kwargs_json
  local arm=$1 gpus=$2 kw=$3 d=$OUT/$1; mkdir -p "$d"; local t0=$(date +%s)
  for i in $(seq -f %02g 0 15); do
    CUDA_VISIBLE_DEVICES=$gpus timeout 900 $PY $VPP/collect_vllm.py --model $MODEL --prompt-file $K/prompts/p$i.txt --out $d/p$i.json --arm $arm $COMMON --llm-kwargs-json "$kw" --metadata prompt_id=p$i > $d/p$i.log 2>&1
    echo "$arm p$i exit=$? $(grep -m1 '^arm=' $d/p$i.log) t=$(( $(date +%s) - t0 ))s"
  done
}
echo "== captures start $(date -u +%T): GPU0 ref_tp1 | GPU1 fp8_tp1 | GPU2,3 ref_tp2 | GPU4,5 fp8_tp2"
( run_arm ref_tp1 0   '{"tensor_parallel_size":1}' ) &
( run_arm fp8_tp1 1   '{"tensor_parallel_size":1,"quantization":"fp8_per_tensor"}' ) &
( run_arm ref_tp2 2,3 '{"tensor_parallel_size":2}' ) &
( run_arm fp8_tp2 4,5 '{"tensor_parallel_size":2,"quantization":"fp8_per_tensor"}' ) &
wait
echo "== captures done $(date -u +%T); json counts: $(for a in ref_tp1 fp8_tp1 ref_tp2 fp8_tp2; do echo -n "$a=$(ls $OUT/$a/*.json 2>/dev/null | wc -l) "; done)"
echo "== profile (kv_cache_quant.py, no gate policy = primary; example policy = illustrative only)"
profile() { # name refarm candarm
  local name=$1 ra=$2 ca=$3 pairs=""
  for i in $(seq -f %02g 0 15); do [ -f $OUT/$ra/p$i.json ] && [ -f $OUT/$ca/p$i.json ] && pairs="$pairs --pair p$i $OUT/$ra/p$i.json $OUT/$ca/p$i.json"; done
  [ -z "$pairs" ] && { echo "$name: no complete pairs"; return; }
  (cd $VPP && $PY profiles/kv_cache_quant.py $pairs --drift-epsilon 0.05 --out $OUT/profile_$name > $OUT/profile_$name.log 2>&1; echo "$name exit=$?")
  (cd $VPP && $PY profiles/kv_cache_quant.py $pairs --drift-epsilon 0.05 --quality-gates profiles/kv_cache_quant_gates.example.json --out $OUT/profile_${name}_examplegate > $OUT/profile_${name}_examplegate.log 2>&1; echo "$name examplegate exit=$?")
}
profile tp1_bf16_vs_fp8 ref_tp1 fp8_tp1
profile tp2_bf16_vs_fp8 ref_tp2 fp8_tp2
profile fp8_tp1_vs_tp2  fp8_tp1 fp8_tp2
profile bf16_tp1_vs_tp2 ref_tp1 ref_tp2
for f in $OUT/profile_*/summary.csv; do echo "-- $f"; head -20 "$f" | cut -c1-200; done
echo KVQ_DONE
